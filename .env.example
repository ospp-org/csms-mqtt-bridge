# ─── Required ───────────────────────────────────────────────────────────────

# MQTT broker URL (full URL incl. protocol).
MQTT_BROKER_URL=mqtts://mqtt-uat.onestoppay.ro:8884

# MQTT clientid for this sidecar; must match the CN of the server certificate
# (per OSPP spec — EMQX uses peer_cert_as_clientid = cn).
MQTT_CLIENT_ID=csms-uat-server-1

# Server certificate (PEM), signed by the Station CA.
MQTT_CERT_PATH=/run/secrets/server-cert.pem

# Server private key (PEM, mode 0600). NOT logged anywhere.
MQTT_KEY_PATH=/run/secrets/server-key.pem

# Redis URL (full URL incl. protocol). The csms-server compose runs Redis with
# --requirepass, so production URLs include the password as the userinfo
# component. Format: redis://[username][:password]@host:port[/db].
# Use rediss:// for TLS-wrapped Redis.
# Point this at the DEDICATED noeviction queue Redis, not the shared cache Redis.
# The shared instance runs `allkeys-lru`: an LPUSH there reports success, the bridge
# PUBACKs, the broker drops its copy, and Redis evicts the entry under memory
# pressure — the message is lost on both sides with no error. Measured: 400 pushes,
# 400 acked, 16 surviving. The bridge REFUSES to start against such an instance
# (see REDIS_REQUIRE_NOEVICTION below).
#
# This must resolve to the SAME instance/db as csms-server's REDIS_MQTT_* — the
# bridge writes the queue and the worker reads it; they have to rendezvous.
REDIS_URL=redis://:<password>@redis-queue:6379/0

# Refuse to start when the queue Redis can evict. Default true. Setting it false
# downgrades the refusal to a warning plus csms_bridge_queue_durability_violations_total;
# it does NOT make the loss safe. Only for a local stack you accept losing messages on.
# REDIS_REQUIRE_NOEVICTION=true

# ─── Optional (defaults shown) ──────────────────────────────────────────────

# CA bundle for verifying the broker certificate. When unset, mqtt.js falls
# back to Node's default TLS trust (system CA bundle, includes Let's Encrypt
# root and other public roots) — the right choice when the broker presents a
# publicly-trusted cert. Required only for non-public CAs (self-signed,
# internal Station CA, etc.).
# MQTT_CA_PATH=/run/secrets/server-chain.pem

# Optional: TLS SNI hostname override (sent to broker during TLS handshake).
# Set when the broker certificate SAN doesn't include the connect hostname.
# Example: connecting intra-Docker to 'emqx' but the broker cert covers
# '*.onestoppay.ro' — set MQTT_SERVERNAME=mqtt-uat.onestoppay.ro.
# When unset, defaults to the host portion of MQTT_BROKER_URL.
# MQTT_SERVERNAME=

# Validate the broker certificate. Default: true. When MQTT_CA_PATH is set,
# the broker cert is validated against that bundle; otherwise against Node's
# system CA trust. DO NOT set to false outside of an ephemeral sandbox — it
# disables peer verification entirely.
# MQTT_REJECT_UNAUTHORIZED=true

# Pino log level: trace | debug | info | warn | error | fatal.
# LOG_LEVEL=info

# Prometheus exporter port (1..65535).
# METRICS_PORT=9090

# Graceful shutdown deadline, in milliseconds.
# SHUTDOWN_TIMEOUT_MS=10000

# MQTT keepalive interval, in seconds.
# MQTT_KEEPALIVE=60

# MQTT reconnect base period, in milliseconds.
# (mqtt.js applies exponential backoff with jitter on top.)
# MQTT_RECONNECT_PERIOD=5000

# MQTT initial connect timeout, in milliseconds.
# MQTT_CONNECT_TIMEOUT=30000

# MQTT 5 Session Expiry Interval, in seconds. With clean:false this keeps the shared
# subscription (and the QoS-1 messages the broker queues for it) alive across a brief
# disconnect. Must be > 0 — a zero expiry deletes the session on disconnect, dropping
# station messages published during a bridge partition (AUDIT-05 F-02).
# MQTT_SESSION_EXPIRY_INTERVAL=3600

# Redis list key the bridge LPUSHes inbound envelopes onto. csms-server's worker
# must read the same key (MQTT_WORKER_QUEUE_INCOMING).
# REDIS_QUEUE_INCOMING=mqtt:incoming
